<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#f4f7fb;color:#172033;line-height:1.6}
header{background:linear-gradient(135deg,#111827,#2563eb);color:white;padding:55px 8%;text-align:center}
header h1{font-size:clamp(2.2rem,6vw,4.5rem);margin-bottom:10px}
header p{font-size:1.15rem;max-width:760px;margin:auto}
.badge{display:inline-block;background:#22c55e;padding:7px 15px;border-radius:30px;font-weight:bold;margin-bottom:18px}
nav{position:sticky;top:0;background:white;padding:14px;text-align:center;box-shadow:0 2px 12px #0002;z-index:5}
nav a{margin:0 10px;color:#1d4ed8;text-decoration:none;font-weight:bold}
section{max-width:1050px;margin:45px auto;padding:0 20px}
h2{font-size:2rem;color:#1d4ed8;margin-bottom:15px}
.card-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}
.card{background:white;padding:24px;border-radius:18px;box-shadow:0 5px 20px #00000012}
.card h3{margin-bottom:8px;color:#111827}
.icon{font-size:2.2rem}
.track{background:#d1d5db;border:10px solid #8b5a2b;border-radius:24px;padding:28px;overflow:hidden}
.road{height:180px;background:#343434;border-radius:18px;position:relative;display:flex;align-items:center}
.road:before{content:"";position:absolute;left:0;right:0;top:50%;border-top:7px dashed white}
.car{font-size:4rem;position:relative;z-index:2;margin-left:35px}
.obstacle{background:#ef4444;color:white;padding:12px;border-radius:10px;font-weight:bold;position:absolute;z-index:3}
.o1{left:32%}.o2{left:57%}.o3{left:80%}
.flow{display:flex;flex-wrap:wrap;gap:10px;align-items:center;justify-content:center;margin-top:20px}
.step{background:#eff6ff;border:2px solid #60a5fa;padding:14px 18px;border-radius:14px;font-weight:bold}
.arrow{font-size:1.5rem;color:#2563eb}
.questions{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:18px}
.question{background:white;border-left:6px solid #22c55e;padding:20px;border-radius:12px;box-shadow:0 4px 15px #0001}
.answer{margin-top:10px;color:#15803d;font-weight:bold}
footer{margin-top:50px;background:#111827;color:white;text-align:center;padding:35px 20px}
.highlight{background:#dbeafe;padding:22px;border-radius:18px;margin-top:20px}
</style>
</head>
